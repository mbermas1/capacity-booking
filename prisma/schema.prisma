// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Warehouse {
  id           String        @id @default(cuid())
  name         String
  location     String
  docks        Dock[]
  staff        Staff[]
  laborShifts  LaborShift[]
  yardCapacity YardCapacity?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Dock {
  id             String               @id @default(cuid())
  name           String
  location       String
  equipmentType  String
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id])
  warehouseId    String
  operatingHours DockOperatingHours[]
  tags           DockTag[]
  bookings       Booking[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([warehouseId])
}

model Carrier {
  id           String       @id @default(cuid())
  name         String       @unique
  email        String?      @unique
  passwordHash String?
  partnerType  PartnerType  @default(CARRIER)
  tags         CarrierTag[]
  bookings     Booking[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Staff {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([warehouseId])
}

model Booking {
  id              String          @id @default(cuid())
  dock            Dock            @relation(fields: [dockId], references: [id])
  dockId          String
  startTime       DateTime
  endTime         DateTime
  carrier         Carrier         @relation(fields: [carrierId], references: [id])
  carrierId       String
  referenceNumber String
  status          BookingStatus   @default(SCHEDULED)
  loadType        LoadType
  priority        BookingPriority @default(STANDARD)
  shipmentVolume  Int?
  tags            BookingTag[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([dockId, startTime, endTime])
  @@index([carrierId, startTime])
}

enum BookingStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

enum LoadType {
  INBOUND
  OUTBOUND
}

enum BookingPriority {
  LOW
  STANDARD
  HIGH
}

enum PartnerType {
  CARRIER
  SUPPLIER
  THIRD_PARTY_LOGISTICS
}

enum TagCategory {
  EQUIPMENT
  COMMODITY
  CARRIER_REQUIREMENT
}

model Tag {
  id                 String       @id @default(cuid())
  category           TagCategory
  name               String
  minDurationMinutes Int? // only meaningful for COMMODITY-category tags
  docks              DockTag[]
  carriers           CarrierTag[]
  bookings           BookingTag[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([category, name])
}

model DockTag {
  dock      Dock     @relation(fields: [dockId], references: [id], onDelete: Cascade)
  dockId    String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime @default(now())

  @@id([dockId, tagId])
}

model CarrierTag {
  carrier   Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  carrierId String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime @default(now())

  @@id([carrierId, tagId])
}

model BookingTag {
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime @default(now())

  @@id([bookingId, tagId])
}

// Tri-state per day: no row = unrestricted, closed=true = no bookings,
// closed=false with both times null = explicitly open 24h.
model DockOperatingHours {
  id        String  @id @default(cuid())
  dock      Dock    @relation(fields: [dockId], references: [id], onDelete: Cascade)
  dockId    String
  dayOfWeek Int // 0=Sunday..6=Saturday, compared against UTC hour/minute
  closed    Boolean @default(false)
  openTime  String? // "HH:MM"
  closeTime String? // "HH:MM"

  @@unique([dockId, dayOfWeek])
}

// Schema placeholder only — nothing reads or writes this yet. Real enforcement
// (tracking actual labor consumption per shift) is deferred, comparable in size
// to rebuilding the booking-overlap engine for a second resource type.
model LaborShift {
  id          String    @id @default(cuid())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId String
  dayOfWeek   Int
  startTime   String // "HH:MM"
  endTime     String // "HH:MM"
  headcount   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Schema placeholder only — nothing reads or writes this yet. See LaborShift.
model YardCapacity {
  id           String    @id @default(cuid())
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId  String    @unique
  trailerSlots Int
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
