// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Warehouse {
  id                   String           @id @default(cuid())
  name                 String
  location             String
  publicBookingSlug    String           @unique // rotatable handle for the public /book link; regenerable on demand
  detentionRatePerHour Float? // $/hour charged after the free-time grace period; null = cost not configured, not estimated
  detentionFreeMinutes Int? // grace period before detention accrues; null (with a rate set) = no grace period
  docks                Dock[]
  staff                Staff[]
  staffAccess          StaffWarehouse[]
  laborShifts          LaborShift[]
  yardCapacity         YardCapacity?
  bookingRequests      BookingRequest[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Dock {
  id                        String               @id @default(cuid())
  name                      String
  location                  String
  equipmentType             String
  capacity                  Int                  @default(1) // max simultaneous bookings
  minLeadTimeMinutes        Int? // null = no lead time requirement (portal bookings only)
  bufferMinutes             Int? // null = no buffer requirement, gap enforced before/after each booking
  reservedHighPrioritySlots Int? // null/0 = no reservation; slots only HIGH-priority bookings can use
  requiresManualReview      Boolean              @default(false) // false = public booking requests auto-approve when available
  warehouse                 Warehouse            @relation(fields: [warehouseId], references: [id])
  warehouseId               String
  operatingHours            DockOperatingHours[]
  tags                      DockTag[]
  bookings                  Booking[]
  bookingRequests           BookingRequest[]
  cancellationRecords       CancellationRecord[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([warehouseId])
}

model Carrier {
  id                  String               @id @default(cuid())
  name                String               @unique // display name, preserves original casing
  nameKey             String               @unique // trim().toLowerCase() of name — the real identity/matching key
  email               String?              @unique // company notification address (confirm/cancel/reschedule/no-show emails) — not a login
  partnerType         PartnerType          @default(CARRIER)
  users               CarrierUser[]
  tags                CarrierTag[]
  bookings            Booking[]
  cancellationRecords CancellationRecord[]
  scoreAppeals        ScoreAppeal[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model CarrierUser {
  id                     String          @id @default(cuid())
  carrier                Carrier         @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  carrierId              String
  name                   String
  email                  String          @unique
  passwordHash           String
  role                   CarrierUserRole @default(MEMBER)
  passwordResetToken     String?         @unique
  passwordResetExpiresAt DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  createdBookings   Booking[]            @relation("BookingCreatedByCarrierUser")
  cancelledBookings CancellationRecord[] @relation("CancellationCancelledByCarrierUser")
  createdAppeals    ScoreAppeal[]        @relation("AppealCreatedByCarrierUser")

  @@index([carrierId])
}

enum CarrierUserRole {
  ADMIN
  MEMBER
}

model CancellationRecord {
  id                String   @id @default(cuid())
  carrier           Carrier  @relation(fields: [carrierId], references: [id])
  carrierId         String
  dock              Dock     @relation(fields: [dockId], references: [id])
  dockId            String
  originalStartTime DateTime
  originalEndTime   DateTime
  referenceNumber   String
  cancelledAt       DateTime @default(now())

  cancelledByStaffId       String?
  cancelledByStaff         Staff?       @relation("CancellationCancelledByStaff", fields: [cancelledByStaffId], references: [id], onDelete: SetNull)
  cancelledByCarrierUserId String?
  cancelledByCarrierUser   CarrierUser? @relation("CancellationCancelledByCarrierUser", fields: [cancelledByCarrierUserId], references: [id], onDelete: SetNull)

  @@index([carrierId])
}

model ScoreAppeal {
  id             String    @id @default(cuid())
  carrier        Carrier   @relation(fields: [carrierId], references: [id])
  carrierId      String
  note           String
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  createdByCarrierUserId String?
  createdByCarrierUser   CarrierUser? @relation("AppealCreatedByCarrierUser", fields: [createdByCarrierUserId], references: [id], onDelete: SetNull)
  resolvedByStaffId      String?
  resolvedByStaff        Staff?       @relation("AppealResolvedByStaff", fields: [resolvedByStaffId], references: [id], onDelete: SetNull)

  @@index([carrierId])
  @@index([resolvedAt])
}

model Staff {
  id                     String           @id @default(cuid())
  name                   String
  email                  String           @unique
  passwordHash           String
  role                   StaffRole        @default(ADMIN) // migration backfill default: existing accounts keep full access
  warehouse              Warehouse        @relation(fields: [warehouseId], references: [id])
  warehouseId            String // home location; sole scope for DOCK_STAFF, base of the assigned set for FACILITY_MANAGER
  warehouseAccess        StaffWarehouse[] // additional locations, FACILITY_MANAGER only
  passwordResetToken     String?          @unique
  passwordResetExpiresAt DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  createdBookings   Booking[]            @relation("BookingCreatedByStaff")
  checkedInBookings Booking[]            @relation("BookingCheckedInByStaff")
  completedBookings Booking[]            @relation("BookingCompletedByStaff")
  cancelledBookings CancellationRecord[] @relation("CancellationCancelledByStaff")
  resolvedAppeals   ScoreAppeal[]        @relation("AppealResolvedByStaff")

  @@index([warehouseId])
}

model StaffWarehouse {
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId String
  createdAt   DateTime  @default(now())

  @@id([staffId, warehouseId])
}

enum StaffRole {
  ADMIN
  FACILITY_MANAGER
  DOCK_STAFF
  ANALYST
}

model Booking {
  id              String          @id @default(cuid())
  dock            Dock            @relation(fields: [dockId], references: [id])
  dockId          String
  startTime       DateTime
  endTime         DateTime
  carrier         Carrier         @relation(fields: [carrierId], references: [id])
  carrierId       String
  referenceNumber String
  status          BookingStatus   @default(SCHEDULED)
  loadType        LoadType
  priority        BookingPriority @default(STANDARD)
  shipmentVolume  Int?
  tags            BookingTag[]
  checkedInAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdByStaffId       String?
  createdByStaff          Staff?      @relation("BookingCreatedByStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  createdByCarrierUserId String?
  createdByCarrierUser    CarrierUser? @relation("BookingCreatedByCarrierUser", fields: [createdByCarrierUserId], references: [id], onDelete: SetNull)
  checkedInByStaffId      String?
  checkedInByStaff         Staff?     @relation("BookingCheckedInByStaff", fields: [checkedInByStaffId], references: [id], onDelete: SetNull)
  completedByStaffId      String?
  completedByStaff          Staff?    @relation("BookingCompletedByStaff", fields: [completedByStaffId], references: [id], onDelete: SetNull)

  @@index([dockId, startTime, endTime])
  @@index([carrierId, startTime])
}

enum BookingStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

enum LoadType {
  INBOUND
  OUTBOUND
}

enum BookingPriority {
  LOW
  STANDARD
  HIGH
}

enum PartnerType {
  CARRIER
  SUPPLIER
  THIRD_PARTY_LOGISTICS
}

enum TagCategory {
  EQUIPMENT
  COMMODITY
  CARRIER_REQUIREMENT
}

enum BookingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Submitted through the public per-warehouse booking link (no login). Never
// becomes a Booking automatically — staff approve/reject, and approval runs
// the same createBooking() constraint engine as every other booking path.
model BookingRequest {
  id                    String               @id @default(cuid())
  warehouse             Warehouse            @relation(fields: [warehouseId], references: [id])
  warehouseId           String
  dock                  Dock                 @relation(fields: [dockId], references: [id])
  dockId                String
  startTime             DateTime
  endTime               DateTime
  companyName           String
  contactEmail          String
  contactPhone          String?
  referenceNumber       String
  loadType              LoadType
  status                BookingRequestStatus @default(PENDING)
  reviewNote            String?
  verificationToken     String?              @unique
  verificationExpiresAt DateTime?
  verifiedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([warehouseId, status])
}

model Tag {
  id                 String       @id @default(cuid())
  category           TagCategory
  name               String
  minDurationMinutes Int? // only meaningful for COMMODITY-category tags
  docks              DockTag[]
  carriers           CarrierTag[]
  bookings           BookingTag[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([category, name])
}

model DockTag {
  dock      Dock     @relation(fields: [dockId], references: [id], onDelete: Cascade)
  dockId    String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime @default(now())

  @@id([dockId, tagId])
}

model CarrierTag {
  carrier   Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  carrierId String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime @default(now())

  @@id([carrierId, tagId])
}

model BookingTag {
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime @default(now())

  @@id([bookingId, tagId])
}

// Tri-state per day: no row = unrestricted, closed=true = no bookings,
// closed=false with both times null = explicitly open 24h.
model DockOperatingHours {
  id        String  @id @default(cuid())
  dock      Dock    @relation(fields: [dockId], references: [id], onDelete: Cascade)
  dockId    String
  dayOfWeek Int // 0=Sunday..6=Saturday, compared against UTC hour/minute
  closed    Boolean @default(false)
  openTime  String? // "HH:MM"
  closeTime String? // "HH:MM"

  @@unique([dockId, dayOfWeek])
}

// Schema placeholder only — nothing reads or writes this yet. Real enforcement
// (tracking actual labor consumption per shift) is deferred, comparable in size
// to rebuilding the booking-overlap engine for a second resource type.
model LaborShift {
  id          String    @id @default(cuid())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId String
  dayOfWeek   Int
  startTime   String // "HH:MM"
  endTime     String // "HH:MM"
  headcount   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Schema placeholder only — nothing reads or writes this yet. See LaborShift.
model YardCapacity {
  id           String    @id @default(cuid())
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId  String    @unique
  trailerSlots Int
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
